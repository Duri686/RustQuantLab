# Pre-commit Hook: 本地测试必须通过才能提交

echo ""
echo "================================================"
echo "🧪 Running Rust tests before commit..."
echo "================================================"
echo ""

cd core && cargo test --lib --release
RUST_EXIT=$?
cd ..

if [ $RUST_EXIT -ne 0 ]; then
  echo ""
  echo "================================================"
  echo "❌ COMMIT BLOCKED: Rust tests failed!"
  echo "================================================"
  echo "Please fix the failing tests before committing."
  echo ""
  exit 1
fi

echo ""
echo "================================================"
echo "✅ All tests passed! Commit allowed."
echo "================================================"
echo ""
